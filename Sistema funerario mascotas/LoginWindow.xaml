<Window x:Class="Sistema_funerario_mascotas.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Iniciar Sesión - Sistema Funerario" 
        WindowState="Maximized"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid>
        <Border Background="#2A2A2A" 
                BorderBrush="#3F3F3F" 
                BorderThickness="1"
                CornerRadius="8" 
                Padding="30" 
                Width="380" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">

            <StackPanel>
                <!-- Título -->
                <TextBlock Text="Bienvenido" FontSize="24" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="Inicie sesión para continuar" Opacity="0.6" FontSize="13" Margin="0,0,0,20"/>

                <!-- Campo E-mail -->
                <TextBlock Text="Correo Electrónico" Margin="0,0,0,6" FontWeight="Medium" FontSize="12"/>
                <ui:TextBox x:Name="TxtEmail" Text="correo@gmail.com"  PlaceholderText="ejemplo@correo.com" Margin="0,0,0,12" HorizontalAlignment="Stretch"/>

                <!-- Campo Contraseña -->
                <TextBlock Text="Contraseña" Margin="0,0,0,6" FontWeight="Medium" FontSize="12"/>
                <ui:PasswordBox x:Name="TxtPassword" Text="password123" PlaceholderText="••••••••" Margin="0,0,0,20" HorizontalAlignment="Stretch"/>

                <!-- Botón Login -->
                <ui:Button Content="Iniciar Sesión" Appearance="Primary" HorizontalAlignment="Stretch" Height="38" Click="BtnLogin_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>