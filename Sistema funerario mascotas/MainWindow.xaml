<Window x:Class="Sistema_funerario_mascotas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sistema_funerario_mascotas"
        xmlns:clients="clr-namespace:Sistema_funerario_mascotas.Views.Clients"
        xmlns:contracts="clr-namespace:Sistema_funerario_mascotas.Views.Contratos"
        xmlns:urnas="clr-namespace:Sistema_funerario_mascotas.Views.Inventario.Urnas"
        xmlns:servicios="clr-namespace:Sistema_funerario_mascotas.Inventario.Servicios"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Sistema Funerario" Height="450" Width="800"
        WindowState="Maximized"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid>
        <ui:NavigationView x:Name="RootNavigation" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="MenuDashboard" Content="Dashboard" Icon="{ui:SymbolIcon Home24}" TargetPageType="{x:Type local:DashboardPage}"/>
                <ui:NavigationViewItem Content="Usuarios" Icon="{ui:SymbolIcon Person24}" TargetPageType="{x:Type local:UsuariosPage}" />
                <ui:NavigationViewItem Content="Clientes" Icon="{ui:SymbolIcon People24}" TargetPageType="{x:Type clients:ClientesPage}" />
                <ui:NavigationViewItem Content="Contratos" Icon="{ui:SymbolIcon DocumentTable24}" TargetPageType="{x:Type contracts:ContratosPage}" />
                <ui:NavigationViewItem Content="Inventario" Icon="{ui:SymbolIcon Box24}">                  
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="Urnas" TargetPageType="{x:Type urnas:UrnasPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon x:Name="PuntitoUrnas" Symbol="Circle16" FontSize="8"/>
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="Servicios" TargetPageType="{x:Type servicios:ServiciosPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon x:Name="PuntitoServicios" Symbol="Circle16" FontSize="8"/>
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Reportes" Icon="{ui:SymbolIcon ChartMultiple24}"/>
                
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                        Content="Cerrar sesión"
                        Icon="{ui:SymbolIcon Power24}"
                        Click="Logout"/>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</Window>