<Page x:Class="Sistema_funerario_mascotas.Views.Inventario.Urnas.DetallesUrnaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      Title="DetallesUrnaPage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:ListView x:Name="LvScrollContainer"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

        <ui:ListView.ItemContainerStyle>
            <Style TargetType="{x:Type ui:ListViewItem}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsHitTestVisible" Value="True"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:ListViewItem}">
                            <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ui:ListView.ItemContainerStyle>

        <ui:ListViewItem>
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Migas de pan -->
                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Urnas" Opacity="0.5" Cursor="Hand" MouseLeftButtonUp="BreadcrumbUrnas_Click" FontSize="12"/>
                    <TextBlock Text=" > " Opacity="0.5" FontSize="12" Margin="5,0"/>
                    <TextBlock Text="Detalles de la Urna" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Encabezado con Botón Volver y Código -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0" Width="38" Height="38" Padding="0" Margin="0,0,15,0" 
                               Appearance="Secondary" ToolTip="Volver al inventario" 
                               HorizontalAlignment="Left" VerticalAlignment="Center" 
                               Click="BtnVolver_Click">
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16"/>
                    </ui:Button>

                    <TextBlock Grid.Column="1" x:Name="TxtTituloCodigo" Text="Detalles de Urna" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>

                <!-- LOADER DE CARGA -->
                <StackPanel x:Name="PanelLoader" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60,0,0">
                    <ui:ProgressRing Width="60" Height="60" IsIndeterminate="True" Foreground="#0EA5E9"/>
                    <TextBlock Text="Cargando detalles de la urna..." HorizontalAlignment="Center" Margin="0,15,0,0" Opacity="0.7" FontSize="14"/>
                </StackPanel>

                <!-- CONTENIDO PRINCIPAL (Oculto hasta cargar) -->
                <Grid x:Name="GridContenidoPrincipal" Grid.Row="2" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <!-- COLUMNA IZQUIERDA: Widgets de resumen y descripción -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,20">

                        <!-- WIDGETS SUPERIORES (Métricas rápidas) -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Widget 1: Existencias -->
                            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Existencias" Opacity="0.7" FontSize="12"/>
                                    <TextBlock x:Name="LblExistencias" Text="0" FontSize="22" FontWeight="Bold" Margin="0,5,0,0" Foreground="#0EA5E9"/>
                                </StackPanel>
                            </Border>

                            <!-- Widget 2: Precio Venta -->
                            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="15" Margin="5,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Precio Venta" Opacity="0.7" FontSize="12"/>
                                    <TextBlock x:Name="LblPrecioVenta" Text="$0.00" FontSize="22" FontWeight="Bold" Margin="0,5,0,0" Foreground="#10B981"/>
                                </StackPanel>
                            </Border>

                            <!-- Widget 3: Stock Mínimo -->
                            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Stock Mínimo" Opacity="0.7" FontSize="12"/>
                                    <TextBlock x:Name="LblStockMinimo" Text="0" FontSize="22" FontWeight="Bold" Margin="0,5,0,0" Foreground="#EAB308"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Información General y Descripción -->
                        <TextBlock Text="1. Información General" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nombre de la Urna" Opacity="0.7" FontSize="12"/>
                                        <TextBlock x:Name="LblNombreUrna" Text="-" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Código Identificador" Opacity="0.7" FontSize="12"/>
                                        <TextBlock x:Name="LblCodigoUrna" Text="-" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,15"/>

                                <StackPanel>
                                    <TextBlock Text="Descripción y Materiales" Opacity="0.7" FontSize="12"/>
                                    <TextBlock x:Name="LblDescripcion" Text="Sin descripción registrada." FontWeight="Normal" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.9"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Costos y Márgenes -->
                        <TextBlock Text="2. Análisis Financiero" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Precio Compra" Opacity="0.7" FontSize="12"/>
                                    <TextBlock x:Name="LblPrecioCompra" Text="$0.00" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Precio Venta" Opacity="0.7" FontSize="12"/>
                                    <TextBlock x:Name="LblCostoVenta" Text="$0.00" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Margen Estimado" Opacity="0.7" FontSize="12"/>
                                    <TextBlock x:Name="LblMargenGanancia" Text="$0.00" FontWeight="Bold" FontSize="14" Margin="0,2,0,0" Foreground="#10B981"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Historial de Movimientos y Auditoría -->
                        <TextBlock Text="3. Historial de Movimientos y Auditoría" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Cabecera de la tabla -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ACCIÓN" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                                    <TextBlock Grid.Column="1" Text="DESCRIPCIÓN" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                                    <TextBlock Grid.Column="2" Text="FECHA" FontWeight="Bold" FontSize="11" Opacity="0.6" HorizontalAlignment="Right"/>
                                </Grid>

                                <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,10"/>

                                <!-- Lista de movimientos -->
                                <ItemsControl Grid.Row="2" x:Name="IcHistorialUrna">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Grid Margin="0,8,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="140"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding action}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#0EA5E9"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding description}" VerticalAlignment="Center" Opacity="0.9" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding created_at}" VerticalAlignment="Center" Opacity="0.7" HorizontalAlignment="Right" FontSize="12"/>
                                                </Grid>
                                                <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,2" Opacity="0.4"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="LblSinHistorial" Text="No hay movimientos registrados para esta urna." Opacity="0.6" FontStyle="Italic" Visibility="Collapsed" Margin="0,10"/>
                            </Grid>
                        </Border>

                    </StackPanel>

                    <!-- COLUMNA DERECHA: Imagen Clara y Acciones -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Fotografía de la Urna" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                            <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,15"/>

                            <!-- Visor grande y claro de la imagen -->
                            <Border Width="240" Height="240" CornerRadius="8" Background="#11FFFFFF" Margin="0,0,0,20" ClipToBounds="True" HorizontalAlignment="Center">
                                <Image x:Name="ImgUrnaDetalle" Source="https://via.placeholder.com/250" Stretch="UniformToFill"/>
                            </Border>

                            <ui:Button Content="Editar esta Urna" Appearance="Secondary" HorizontalAlignment="Stretch" Height="40" Margin="0,0,0,10" Click="BtnEditar_Click"/>
                            <ui:Button Content="Volver al Inventario" Appearance="Primary" HorizontalAlignment="Stretch" Height="40" Click="BtnVolver_Click"/>
                        </StackPanel>
                    </Border>

                </Grid>
                <ui:SnackbarPresenter x:Name="SnackbarHost" Grid.Row="0" Grid.RowSpan="3"/>
            </Grid>

        </ui:ListViewItem>
    </ui:ListView>
</Page>