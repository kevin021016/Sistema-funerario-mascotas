<ui:FluentWindow x:Class="Sistema_funerario_mascotas.Views.CustomMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Mensaje" 
        SizeToContent="Height" 
        MinHeight="160" 
        Width="380"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="25,35,25,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock x:Name="TxtTitle" Grid.Row="0" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>

        <!-- Mensaje -->
        <TextBlock x:Name="TxtMessage" Grid.Row="1" TextWrapping="Wrap" Opacity="0.8" FontSize="14" Margin="0,0,0,20"/>

        <!-- Botón Aceptar -->
        <ui:Button Grid.Row="2" Content="Aceptar" Appearance="Primary" HorizontalAlignment="Right" Width="100" Click="BtnAceptar_Click"/>
    </Grid>
</ui:FluentWindow>