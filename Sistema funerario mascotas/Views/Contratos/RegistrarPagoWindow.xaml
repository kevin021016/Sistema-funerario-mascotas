<Window x:Class="Sistema_funerario_mascotas.Views.Contratos.RegistrarPagoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Registrar Abono o Pago" Height="520" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Registrar Nuevo Abono" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Monto -->
                <TextBlock Text="Monto del Abono ($)" FontWeight="Medium" Margin="0,0,0,5"/>
                <ui:TextBox x:Name="TxtMonto" PlaceholderText="0.00" Margin="0,0,0,12"/>

                <!-- Tipo de Pago -->
                <TextBlock Text="Tipo de Pago" FontWeight="Medium" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbTipoPago" Margin="0,0,0,12" Height="35">
                    <ComboBoxItem Content="abono" IsSelected="True"/>
                    <ComboBoxItem Content="enganche"/>
                </ComboBox>

                <!-- Método de Pago -->
                <TextBlock Text="Método de Pago" FontWeight="Medium" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbMetodo" Margin="0,0,0,12" Height="35">
                    <ComboBoxItem Content="Efectivo" IsSelected="True"/>
                    <ComboBoxItem Content="Tarjeta de Crédito"/>
                    <ComboBoxItem Content="Tarjeta de Débito"/>
                    <ComboBoxItem Content="Transferencia"/>
                </ComboBox>

                <!-- Referencia -->
                <TextBlock Text="Referencia / Folio de Operación" FontWeight="Medium" Margin="0,0,0,5"/>
                <ui:TextBox x:Name="TxtReferencia" PlaceholderText="Ej. REF-12345" Margin="0,0,0,12"/>

                <!-- Observaciones -->
                <TextBlock Text="Observaciones" FontWeight="Medium" Margin="0,0,0,5"/>
                <ui:TextBox x:Name="TxtObservaciones" PlaceholderText="Notas adicionales..." AcceptsReturn="True" Height="60" Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Botón Guardar -->
        <ui:Button Grid.Row="2" Content="Guardar y Registrar Pago" Appearance="Primary" Height="40" HorizontalAlignment="Stretch" Click="GuardarPago_Click" Margin="0,15,0,0"/>
    </Grid>
</Window>