<Page x:Class="Sistema_funerario_mascotas.Views.Contratos.DetallesContratoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      Title="DetallesContratoPage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:ListView x:Name="LvScrollContainer"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

        <ui:ListView.ItemContainerStyle>
            <Style TargetType="{x:Type ui:ListViewItem}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsHitTestVisible" Value="True"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:ListViewItem}">
                            <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ui:ListView.ItemContainerStyle>

        <ui:ListViewItem>
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Migas de pan -->
                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Contratos" Opacity="0.5" Cursor="Hand" MouseLeftButtonUp="BreadcrumbContratos_Click" FontSize="12"/>
                    <TextBlock Text=" > " Opacity="0.5" FontSize="12" Margin="5,0"/>
                    <TextBlock Text="Detalles del Contrato" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Encabezado con Botón Volver y Folio -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0" Width="38" Height="38" Padding="0" Margin="0,0,15,0" 
                               Appearance="Secondary" ToolTip="Volver a contratos" 
                               HorizontalAlignment="Left" VerticalAlignment="Center" 
                               Click="BtnVolver_Click">
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16"/>
                    </ui:Button>

                    <TextBlock Grid.Column="1" x:Name="TxtTituloFolio" Text="Detalles del Contrato" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>

                <!-- LOADER DE CARGA -->
                <StackPanel x:Name="PanelLoader" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60,0,0">
                    <ui:ProgressRing Width="60" Height="60" IsIndeterminate="True" Foreground="#0EA5E9"/>
                    <TextBlock Text="Cargando detalles del contrato..." HorizontalAlignment="Center" Margin="0,15,0,0" Opacity="0.7" FontSize="14"/>
                </StackPanel>

                <!-- CONTENIDO PRINCIPAL (Oculto hasta cargar) -->
                <Grid x:Name="GridContenidoPrincipal" Grid.Row="2" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- COLUMNA IZQUIERDA: Información detallada -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,20">

                        <!-- 1. Información General y Cliente -->
                        <TextBlock Text="1. Información del Cliente y Mascota" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Cliente Titular" Opacity="0.7" FontSize="12"/>
                                        <TextBlock x:Name="LblClienteNombre" Text="-" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Teléfono / Celular" Opacity="0.7" FontSize="12"/>
                                        <TextBlock x:Name="LblClienteTelefono" Text="-" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,15"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Mascota" Opacity="0.7" FontSize="12"/>
                                        <TextBlock x:Name="LblMascotaNombre" Text="-" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Tipo / Especie" Opacity="0.7" FontSize="12"/>
                                        <TextBlock x:Name="LblMascotaTipo" Text="-" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Peso" Opacity="0.7" FontSize="12"/>
                                        <TextBlock x:Name="LblMascotaPeso" Text="No especificado" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Edad" Opacity="0.7" FontSize="12"/>
                                        <TextBlock x:Name="LblMascotaEdad" Text="No especificada" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. Paquete y Urna -->
                        <TextBlock Text="2. Paquete y Urna Asignada" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Paquete Funerario" Opacity="0.7" FontSize="12"/>
                                        <TextBlock x:Name="LblPaqueteNombre" Text="-" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" x:Name="LblPaquetePrecio" Text="$0.00" FontWeight="Bold" FontSize="16" VerticalAlignment="Bottom"/>
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,15"/>

                                <StackPanel>
                                    <TextBlock Text="Urna Funeraria" Opacity="0.7" FontSize="12"/>
                                    <TextBlock x:Name="LblUrnaNombre" Text="Ninguna asignada" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 3. Servicios Extras -->
                        <TextBlock Text="3. Servicios Extras Contratados" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <ItemsControl x:Name="IcServiciosExtrasDetalle">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding nombre}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding precio_aplicado_formato}" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="LblSinExtras" Text="No se agregaron servicios extras." Opacity="0.6" FontStyle="Italic" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- 4. Información de Pago y Fechas -->
                        <TextBlock Text="4. Esquema Financiero y Fechas" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Tipo de Pago" Opacity="0.7" FontSize="12"/>
                                        <TextBlock x:Name="LblTipoPago" Text="-" FontWeight="SemiBold" FontSize="14"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Método / Modalidad" Opacity="0.7" FontSize="12"/>
                                        <TextBlock x:Name="LblMetodoModalidad" Text="-" FontWeight="SemiBold" FontSize="14"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Fecha de Venta" Opacity="0.7" FontSize="12"/>
                                        <TextBlock x:Name="LblFechaVenta" Text="-" FontWeight="SemiBold" FontSize="14"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Fecha Primer Pago" Opacity="0.7" FontSize="12"/>
                                        <TextBlock x:Name="LblFechaPrimerPago" Text="-" FontWeight="SemiBold" FontSize="14"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="PanelInfoCredito" Visibility="Collapsed">
                                    <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,8,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Frecuencia" Opacity="0.7" FontSize="12"/>
                                            <TextBlock x:Name="LblFrecuencia" Text="-" FontWeight="SemiBold" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Monto por Cuota" Opacity="0.7" FontSize="12"/>
                                            <TextBlock x:Name="LblMontoPorCuota" Text="$0.00" FontWeight="SemiBold" FontSize="14"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- COLUMNA DERECHA: Resumen Financiero -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Resumen de Cuenta" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                            <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,15"/>

                            <Grid Margin="0,5">
                                <TextBlock Text="Subtotal Paquete:" Opacity="0.8"/>
                                <TextBlock x:Name="LblSubtotalPaquete" Text="$0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Margin="0,5">
                                <TextBlock Text="Servicios Extras:" Opacity="0.8"/>
                                <TextBlock x:Name="LblServiciosExtras" Text="$0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,15"/>

                            <Grid Margin="0,5">
                                <TextBlock Text="Monto Total Final:" FontSize="14" FontWeight="Bold"/>
                                <TextBlock x:Name="LblMontoFinal" Text="$0.00" FontSize="16" FontWeight="Bold" Foreground="#0EA5E9" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,5">
                                <TextBlock Text="Enganche Abonado:" Opacity="0.8"/>
                                <TextBlock x:Name="LblResumenEnganche" Text="$0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Margin="0,5">
                                <TextBlock Text="Saldo Pendiente:" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LblMontoRestante" Text="$0.00" FontSize="14" FontWeight="SemiBold" Foreground="#EF4444" HorizontalAlignment="Right"/>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,20"/>

                            <ui:Button Content="Editar Contrato" Appearance="Secondary" HorizontalAlignment="Stretch" Height="40" Margin="0,0,0,10" Click="BtnEditar_Click"/>
                            <ui:Button Content="Volver a la Lista" Appearance="Primary" HorizontalAlignment="Stretch" Height="40" Click="BtnVolver_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <ui:SnackbarPresenter x:Name="SnackbarHost" Grid.Row="0" Grid.RowSpan="3"/>
            </Grid>
        </ui:ListViewItem>
    </ui:ListView>
</Page>