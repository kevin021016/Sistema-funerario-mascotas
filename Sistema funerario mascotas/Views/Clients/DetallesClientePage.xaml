<Page x:Class="Sistema_funerario_mascotas.Views.Clients.DetallesClientePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      Title="DetallesClientePage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:ListView x:Name="LvScrollContainer"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

        <ui:ListView.ItemContainerStyle>
            <Style TargetType="{x:Type ui:ListViewItem}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsHitTestVisible" Value="True"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:ListViewItem}">
                            <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ui:ListView.ItemContainerStyle>

        <ui:ListViewItem>
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Migas de pan -->
                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Clientes" Opacity="0.5" Cursor="Hand" MouseLeftButtonUp="BreadcrumbClientes_Click" FontSize="12"/>
                    <TextBlock Text=" > " Opacity="0.5" FontSize="12" Margin="5,0"/>
                    <TextBlock Text="Expediente del Cliente" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Encabezado con Botón Volver y Nombre -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0" Width="38" Height="38" Padding="0" Margin="0,0,15,0" 
                               Appearance="Secondary" ToolTip="Volver a la lista de clientes" 
                               HorizontalAlignment="Left" VerticalAlignment="Center" 
                               Click="BtnVolver_Click">
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16"/>
                    </ui:Button>

                    <TextBlock Grid.Column="1" x:Name="TxtTituloNombre" Text="Expediente del Cliente" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>

                <!-- LOADER DE CARGA -->
                <StackPanel x:Name="PanelLoader" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60,0,0">
                    <ui:ProgressRing Width="60" Height="60" IsIndeterminate="True" Foreground="#0EA5E9"/>
                    <TextBlock Text="Cargando expediente del cliente..." HorizontalAlignment="Center" Margin="0,15,0,0" Opacity="0.7" FontSize="14"/>
                </StackPanel>

                <!-- CONTENIDO PRINCIPAL (Oculto hasta cargar) -->
                <StackPanel x:Name="GridContenidoPrincipal" Grid.Row="2" Visibility="Collapsed">

                    <!-- WIDGETS SUPERIORES (Métricas financieras y contratos) -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Widget 1: Total Contratos -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Contratos Registrados" Opacity="0.7" FontSize="12"/>
                                <TextBlock x:Name="LblTotalContratos" Text="0" FontSize="22" FontWeight="Bold" Margin="0,5,0,0" Foreground="#0EA5E9"/>
                            </StackPanel>
                        </Border>

                        <!-- Widget 2: Monto Acumulado Invertido -->
                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="15" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="Inversión Acumulada" Opacity="0.7" FontSize="12"/>
                                <TextBlock x:Name="LblInversionAcumulada" Text="$0.00" FontSize="22" FontWeight="Bold" Margin="0,5,0,0" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>

                        <!-- Widget 3: Estatus General -->
                        <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Estatus de Cuenta" Opacity="0.7" FontSize="12"/>
                                <TextBlock x:Name="LblEstatusCliente" Text="Activo" FontSize="22" FontWeight="Bold" Margin="0,5,0,0" Foreground="#EAB308"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Sección: Datos Generales de Contacto -->
                    <TextBlock Text="1. Información de Contacto" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Nombre Completo" Opacity="0.7" FontSize="12"/>
                                    <TextBlock x:Name="LblNombreCliente" Text="-" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                    <TextBlock Text="Teléfono de Contacto" Opacity="0.7" FontSize="12"/>
                                    <TextBlock x:Name="LblTelefono" Text="-" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                    <TextBlock Text="Correo Electrónico" Opacity="0.7" FontSize="12"/>
                                    <TextBlock x:Name="LblEmail" Text="-" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,15"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Dirección / Domicilio" Opacity="0.7" FontSize="12"/>
                                    <TextBlock x:Name="LblDireccion" Text="Sin dirección registrada." FontWeight="Normal" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.9"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Sección: Historial de Contratos del Cliente -->
                    <TextBlock Text="2. Contratos Funerarios del Cliente" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Cabecera de la tabla de contratos -->
                            <Grid Grid.Row="0" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="FOLIO" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                                <TextBlock Grid.Column="1" Text="MASCOTA" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                                <TextBlock Grid.Column="2" Text="TOTAL" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                                <TextBlock Grid.Column="3" Text="ESTATUS" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                                <TextBlock Grid.Column="4" Text="ACCIONES" FontWeight="Bold" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
                            </Grid>

                            <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,10"/>

                            <!-- Lista de Contratos -->
                            <ItemsControl Grid.Row="2" x:Name="IcContratosCliente">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid Margin="0,10,0,10" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Folio -->
                                                <TextBlock Grid.Column="0" Text="{Binding folio}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                                <!-- Mascota -->
                                                <TextBlock Grid.Column="1" Text="{Binding mascota_nombre}" VerticalAlignment="Center" Opacity="0.9"/>

                                                <!-- Monto Final -->
                                                <TextBlock Grid.Column="2" Text="{Binding monto_final_formato}" VerticalAlignment="Center" FontWeight="Medium" Foreground="#10B981"/>

                                                <!-- Estatus -->
                                                <TextBlock Grid.Column="3" Text="{Binding estatus}" VerticalAlignment="Center" FontWeight="SemiBold"/>

                                                <!-- Botón Ver Detalles del Contrato -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Width="32" Height="32" Margin="3" Padding="0" Background="#0EA5E9" BorderBrush="{x:Null}" 
                                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="Ver detalles del contrato" 
                                                            Click="IrDetallesContrato_Click">
                                                        <ui:SymbolIcon Symbol="Eye24" FontSize="14" Foreground="White"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,5" Opacity="0.5"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Mensaje cuando no hay contratos -->
                            <TextBlock x:Name="LblSinContratos" Text="Este cliente aún no registra contratos funerarios." Opacity="0.6" FontStyle="Italic" Visibility="Collapsed" Margin="0,15" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                </StackPanel>

                <ui:SnackbarPresenter x:Name="SnackbarHost" Grid.Row="0" Grid.RowSpan="3"/>
            </Grid>
        </ui:ListViewItem>
    </ui:ListView>
</Page>