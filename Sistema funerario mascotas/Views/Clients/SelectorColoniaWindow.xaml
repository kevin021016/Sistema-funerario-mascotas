<Window x:Class="Sistema_funerario_mascotas.Views.Clients.SelectorColoniaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Seleccionar Colonia" Height="400" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de búsqueda -->
        <ui:TextBox Grid.Row="0" x:Name="TxtBuscadorColonia" PlaceholderText="Buscar por nombre o C.P..." Icon="{ui:SymbolIcon Search24}" TextChanged="TxtBuscadorColonia_TextChanged" Margin="0,0,0,15"/>

        <!-- Lista de colonias envuelta en un Border para el CornerRadius -->
        <Border Grid.Row="1" Background="Transparent" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
            <ListView x:Name="LvColonias" SelectionMode="Single" MouseDoubleClick="LvColonias_MouseDoubleClick" Background="Transparent" BorderThickness="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="8,6" CornerRadius="4">
                                        <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- Efecto Hover -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                        </Trigger>

                                        <!-- Efecto Seleccionado (Queda fijo con el mismo color del hover) -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Nombre de Colonia" Width="240" DisplayMemberBinding="{Binding nombre}"/>
                        <GridViewColumn Header="C.P." Width="90" DisplayMemberBinding="{Binding codigo_postal}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Botones inferiores -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <ui:Button Content="Cancelar" Appearance="Secondary" Width="90" Margin="0,0,10,0" Click="BtnCancelar_Click"/>
            <ui:Button Content="Seleccionar" Appearance="Primary" Width="100" Click="BtnSeleccionar_Click"/>
        </StackPanel>
    </Grid>
</Window>