<Page x:Class="Sistema_funerario_mascotas.Views.Reportes.ReportesContratosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      Title="ReportesContratosPage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- ListView con un solo item usado como contenedor scrolleable (el ScrollViewer normal no responde a la rueda del mouse en esta app) -->
    <ui:ListView x:Name="LvScrollContainer"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

        <ui:ListView.ItemContainerStyle>
            <Style TargetType="{x:Type ui:ListViewItem}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsHitTestVisible" Value="True"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:ListViewItem}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ui:ListView.ItemContainerStyle>

        <ui:ListViewItem>
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Migas de pan (Breadcrumb) -->
                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Dashboard" Opacity="0.5" Cursor="Hand" MouseLeftButtonUp="BreadcrumbDashboard_Click" FontSize="12"/>
                    <TextBlock Text=" > " Opacity="0.5" FontSize="12" Margin="5,0"/>
                    <TextBlock Text="Reportes" Opacity="0.5" Cursor="Hand" MouseLeftButtonUp="BreadcrumbReportes_Click" FontSize="12"/>
                    <TextBlock Text=" > " Opacity="0.5" FontSize="12" Margin="5,0"/>
                    <TextBlock Text="Contratos" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- 2. Título y Botón Volver -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0" Width="38" Height="38" Padding="0" Margin="0,0,15,0" 
                               Appearance="Secondary" ToolTip="Volver" 
                               HorizontalAlignment="Left" VerticalAlignment="Center" 
                               Click="BreadcrumbReportes_Click">
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16"/>
                    </ui:Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Reporte de Contratos" FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="Detalle general, montos, asesores y periodicidad de pagos" FontSize="13" Opacity="0.6" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 3. Barra de Filtros -->
                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Buscar" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,5"/>
                            <ui:TextBox x:Name="TxtBuscador" PlaceholderText="Folio, cliente..." Icon="{ui:SymbolIcon Search24}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Desde (fecha de venta)" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,5"/>
                            <ui:TextBox x:Name="TxtFechaDesde" PlaceholderText="DD/MM/AAAA"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="Hasta (fecha de venta)" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,5"/>
                            <ui:TextBox x:Name="TxtFechaHasta" PlaceholderText="DD/MM/AAAA"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="0,0,12,0">
                            <TextBlock Text="Estatus" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CbFiltroEstatus" Height="36" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="Todos"/>
                                <ComboBoxItem Content="activo"/>
                                <ComboBoxItem Content="liquidado"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Margin="0,0,12,0">
                            <TextBlock Text="Tipo de pago" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CbFiltroTipoPago" Height="36" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="Todos"/>
                                <ComboBoxItem Content="Contado"/>
                                <ComboBoxItem Content="Crédito"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="5" Margin="0,0,12,0">
                            <TextBlock Text="Modalidad" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CbFiltroModalidad" Height="36" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="Todas"/>
                                <ComboBoxItem Content="Semanal"/>
                                <ComboBoxItem Content="Quincenal"/>
                                <ComboBoxItem Content="Mensual"/>
                            </ComboBox>
                        </StackPanel>

                        <ui:Button Grid.Column="7" Content="Generar" Appearance="Primary" Width="100" Height="36" VerticalAlignment="Bottom" Click="BtnGenerar_Click"/>
                    </Grid>
                </Border>

                <!-- 4. Tarjetas de Métricas -->
                <UniformGrid Grid.Row="3" Columns="3" Margin="0,0,0,20">
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="Total Contratos" FontSize="12" Opacity="0.6" Margin="0,0,0,8"/>
                            <TextBlock x:Name="LblTotalContratos" Text="0" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Monto Recaudado" FontSize="12" Opacity="0.6" Margin="0,0,0,8"/>
                            <TextBlock x:Name="LblMontoRecaudado" Text="$0.00" FontSize="24" FontWeight="Bold" Foreground="#10B981"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Monto Pendiente" FontSize="12" Opacity="0.6" Margin="0,0,0,8"/>
                            <TextBlock x:Name="LblMontoPendiente" Text="$0.00" FontSize="24" FontWeight="Bold" Foreground="#EF4444"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 5. Contenedor de la Tabla -->
                <Border Grid.Row="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Cabecera de la Tabla -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FOLIO" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                            <TextBlock Grid.Column="1" Text="CLIENTE / MASCOTA" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                            <TextBlock Grid.Column="2" Text="ASESOR" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                            <TextBlock Grid.Column="3" Text="1ER PAGO" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                            <TextBlock Grid.Column="4" Text="RECAUDADO" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                            <TextBlock Grid.Column="5" Text="PENDIENTE" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                            <TextBlock Grid.Column="6" Text="TIPO DE PAGO" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                            <TextBlock Grid.Column="7" Text="MODALIDAD" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                            <TextBlock Grid.Column="8" Text="ESTATUS" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                        </Grid>

                        <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,12"/>

                        <!-- LOADER -->
                        <StackPanel x:Name="PanelLoader" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,40" Visibility="Collapsed">
                            <ui:ProgressRing Width="40" Height="40" IsIndeterminate="True" Foreground="#0EA5E9"/>
                            <TextBlock Text="Cargando contratos..." HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0.7" FontSize="12"/>
                        </StackPanel>

                        <!-- Lista de Contratos. Sin scroll propio: la página entera hace scroll -->
                        <ui:ListView Grid.Row="2" x:Name="IcContratosReporte"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">

                            <ui:ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ui:ListViewItem}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ui:ListView.ItemContainerStyle>

                            <ui:ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid Margin="0,12,0,12" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Folio y Fecha de venta -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding folio}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding fecha_venta_formato}" FontSize="11" Opacity="0.6" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Cliente y Mascota -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding cliente_nombre_completo}" FontWeight="Medium" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding mascota_nombre_tipo}" FontSize="11" Opacity="0.6" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Asesor -->
                                            <TextBlock Grid.Column="2" Text="{Binding asesor_nombre}" VerticalAlignment="Center" Opacity="0.9" TextWrapping="Wrap" Margin="0,0,10,0"/>

                                            <!-- Fecha Primer Pago -->
                                            <TextBlock Grid.Column="3" Text="{Binding fecha_primer_pago_formato}" VerticalAlignment="Center" Opacity="0.9"/>

                                            <!-- Recaudado -->
                                            <TextBlock Grid.Column="4" Text="{Binding monto_recaudado_formato}" FontWeight="Medium" Foreground="#10B981" VerticalAlignment="Center"/>

                                            <!-- Pendiente -->
                                            <TextBlock Grid.Column="5" Text="{Binding monto_restante_formato}" FontWeight="Medium" Foreground="#EF4444" VerticalAlignment="Center"/>

                                            <!-- Tipo de pago (Contado / Crédito) -->
                                            <TextBlock Grid.Column="6" Text="{Binding tipo_pago_formato}" VerticalAlignment="Center" Opacity="0.9"/>

                                            <!-- Modalidad (Semanal / Quincenal / Mensual) -->
                                            <TextBlock Grid.Column="7" Text="{Binding modalidad_formato}" VerticalAlignment="Center" Opacity="0.9"/>

                                            <!-- Estatus -->
                                            <TextBlock Grid.Column="8" Text="{Binding estatus}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,6"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ui:ListView.ItemTemplate>
                        </ui:ListView>
                    </Grid>
                </Border>

                <!-- 6. Botones de Exportar al final -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <ui:Button Content="Exportar CSV" Margin="5,0,5,0" Appearance="Secondary"/>
                    <ui:Button Content="Exportar a Excel" Margin="5,0,5,0" Appearance="Secondary"/>
                    <ui:Button Content="Imprimir PDF" Margin="5,0,0,0" Appearance="Primary"/>
                </StackPanel>
            </Grid>
        </ui:ListViewItem>
    </ui:ListView>
</Page>