<Page x:Class="Sistema_funerario_mascotas.Views.Reportes.ReportesUsuariosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      Title="ReportesUsuariosPage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- ListView con un solo item usado como contenedor scrolleable (el ScrollViewer normal no responde a la rueda del mouse en esta app) -->
    <ui:ListView x:Name="LvScrollContainer"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

        <ui:ListView.ItemContainerStyle>
            <Style TargetType="{x:Type ui:ListViewItem}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsHitTestVisible" Value="True"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:ListViewItem}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ui:ListView.ItemContainerStyle>

        <ui:ListViewItem>
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Migas de pan (Breadcrumb) -->
                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Dashboard" Opacity="0.5" Cursor="Hand" MouseLeftButtonUp="BreadcrumbDashboard_Click" FontSize="12"/>
                    <TextBlock Text=" > " Opacity="0.5" FontSize="12" Margin="5,0"/>
                    <TextBlock Text="Reportes" Opacity="0.5" Cursor="Hand" MouseLeftButtonUp="BreadcrumbReportes_Click" FontSize="12"/>
                    <TextBlock Text=" > " Opacity="0.5" FontSize="12" Margin="5,0"/>
                    <TextBlock Text="Usuarios" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- 2. Título y Botón Volver -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0" Width="38" Height="38" Padding="0" Margin="0,0,15,0" 
                               Appearance="Secondary" ToolTip="Volver" 
                               HorizontalAlignment="Left" VerticalAlignment="Center" 
                               Click="BreadcrumbReportes_Click">
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16"/>
                    </ui:Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Reporte de Usuarios" FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="Personal y administradores registrados en el sistema" FontSize="13" Opacity="0.6" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 3. Barra de Filtros (Fechas y Rol) -->
                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Desde -->
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="Desde" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,5"/>
                            <ui:TextBox x:Name="TxtFechaDesde" PlaceholderText="DD/MM/AAAA"/>
                        </StackPanel>

                        <!-- Hasta -->
                        <StackPanel Grid.Column="1" Margin="0,0,15,0">
                            <TextBlock Text="Hasta" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,5"/>
                            <ui:TextBox x:Name="TxtFechaHasta" PlaceholderText="DD/MM/AAAA"/>
                        </StackPanel>

                        <!-- Rol -->
                        <StackPanel Grid.Column="2" Margin="0,0,15,0">
                            <TextBlock Text="Rol" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CbFiltroRol" Height="36" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="Todos"/>
                                <ComboBoxItem Content="Administrador"/>
                                <ComboBoxItem Content="Vendedor"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Botón Generar -->
                        <ui:Button Grid.Column="4" Content="Generar" Appearance="Primary" Width="110" Height="36" VerticalAlignment="Bottom" Click="BtnGenerar_Click"/>
                    </Grid>
                </Border>

                <!-- 4. Tarjetas de Métricas -->
                <UniformGrid Grid.Row="3" Columns="3" Margin="0,0,0,20">
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Total Registros" FontSize="12" Opacity="0.6" Margin="0,0,0,8"/>
                            <TextBlock x:Name="LblTotalRegistros" Text="0" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="5,0,5,0">
                        <StackPanel>
                            <TextBlock Text="Administradores" FontSize="12" Opacity="0.6" Margin="0,0,0,8"/>
                            <TextBlock x:Name="LblTotalAdmins" Text="0" FontSize="24" FontWeight="Bold" Foreground="#0EA5E9"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Vendedores" FontSize="12" Opacity="0.6" Margin="0,0,0,8"/>
                            <TextBlock x:Name="LblTotalPersonal" Text="0" FontSize="24" FontWeight="Bold" Foreground="#EAB308"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 5. Contenedor de la Tabla -->
                <Border Grid.Row="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Cabecera de la Tabla -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="NOMBRE" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                            <TextBlock Grid.Column="1" Text="APELLIDOS" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                            <TextBlock Grid.Column="2" Text="CORREO" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                            <TextBlock Grid.Column="3" Text="TELÉFONO" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                            <TextBlock Grid.Column="4" Text="ROL" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                        </Grid>

                        <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,10"/>

                        <!-- LOADER -->
                        <StackPanel x:Name="PanelLoader" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,40" Visibility="Collapsed">
                            <ui:ProgressRing Width="40" Height="40" IsIndeterminate="True" Foreground="#0EA5E9"/>
                            <TextBlock Text="Cargando usuarios..." HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0.7" FontSize="12"/>
                        </StackPanel>

                        <!-- Lista sin paginación (/all). Sin scroll propio: la página entera hace scroll -->
                        <ui:ListView Grid.Row="2" x:Name="IcUsuariosReporte"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">

                            <ui:ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ui:ListViewItem}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ui:ListView.ItemContainerStyle>

                            <ui:ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid Margin="0,8,0,8" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding apellidos}" VerticalAlignment="Center" Opacity="0.9"/>
                                            <TextBlock Grid.Column="2" Text="{Binding email}" VerticalAlignment="Center" Opacity="0.9"/>
                                            <TextBlock Grid.Column="3" Text="{Binding telefono}" VerticalAlignment="Center" Opacity="0.9"/>
                                            <TextBlock Grid.Column="4" Text="{Binding rol}" FontWeight="Medium" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ui:ListView.ItemTemplate>
                        </ui:ListView>
                    </Grid>
                </Border>

                <!-- 6. Botones de Exportar al final -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <ui:Button Content="Exportar CSV" Margin="5,0,5,0" Appearance="Secondary"/>
                    <ui:Button Content="Exportar a Excel" Margin="5,0,5,0" Appearance="Secondary"/>
                    <ui:Button Content="Imprimir PDF" Margin="5,0,0,0" Appearance="Primary"/>
                </StackPanel>
            </Grid>
        </ui:ListViewItem>
    </ui:ListView>
</Page>