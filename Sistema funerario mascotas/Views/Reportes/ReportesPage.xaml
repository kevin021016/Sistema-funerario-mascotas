<Page x:Class="Sistema_funerario_mascotas.Views.Reportes.ReportesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      Title="ReportesPage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:ListView x:Name="LvScrollContainer"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

        <ui:ListView.ItemContainerStyle>
            <Style TargetType="{x:Type ui:ListViewItem}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsHitTestVisible" Value="True"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:ListViewItem}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ui:ListView.ItemContainerStyle>

        <ui:ListViewItem>
            <Grid Margin="35">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Migas de pan y Buscador Superior -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Dashboard" Opacity="0.5" FontSize="12"/>
                        <TextBlock Text=" > " Opacity="0.5" FontSize="12" Margin="5,0"/>
                        <TextBlock Text="Reportes" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>

                </Grid>

                <!-- 2. Título principal -->
                <StackPanel Grid.Row="1" Margin="0,0,0,25">
                    <TextBlock Text="Centro de reportes" FontSize="28" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="Selecciona un módulo y genera tu reporte" FontSize="13" Opacity="0.6"/>
                </StackPanel>

                <!-- 4. Sección: ADMINISTRACIÓN -->
                <StackPanel Grid.Row="3" Margin="0,0,0,25">
                    <TextBlock Text="ADMINISTRACIÓN" FontSize="11" FontWeight="Bold" Opacity="0.5" Margin="0,0,0,12"/>
                    <UniformGrid Columns="2" HorizontalAlignment="Stretch">
                        <!-- Tarjeta Usuarios -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="24" MinHeight="140" Margin="0,0,10,0" Cursor="Hand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                                    <Border Width="38" Height="38" Background="#1A0EA5E9" CornerRadius="8" Margin="0,0,12,0">
                                        <ui:SymbolIcon Symbol="Person24" FontSize="20" Foreground="#0EA5E9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Usuarios" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="Accesos, roles y actividad del personal." FontSize="13" Opacity="0.6" Margin="0,0,0,15" TextWrapping="Wrap"/>

                                <Grid Grid.Row="2">
                                    <ui:Button Appearance="Transparent"
                                               HorizontalAlignment="Right"
                                               Padding="6,2"
                                               Click="IrReportes_Usuarios">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Generar reporte"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       Foreground="#0EA5E9"
                                                       Margin="0,0,6,0" />
                                            <ui:SymbolIcon Symbol="ChevronRight16"
                                                           FontSize="12"
                                                           Foreground="#0EA5E9"
                                                           VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ui:Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Tarjeta Clientes -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="24" MinHeight="140" Margin="10,0,0,0" Cursor="Hand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                                    <Border Width="38" Height="38" Background="#1A0EA5E9" CornerRadius="8" Margin="0,0,12,0">
                                        <ui:SymbolIcon Symbol="People24" FontSize="20" Foreground="#0EA5E9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Clientes" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="Listado, historial y saldos por cliente." FontSize="13" Opacity="0.6" Margin="0,0,0,15" TextWrapping="Wrap"/>

                                <Grid Grid.Row="2">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Generar reporte" FontSize="13" FontWeight="Medium" Foreground="#0EA5E9" Margin="0,0,6,0"/>
                                        <ui:SymbolIcon Symbol="ChevronRight16" FontSize="12" Foreground="#0EA5E9" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <!-- 5. Sección: OPERACIÓN -->
                <StackPanel Grid.Row="4" Margin="0,0,0,25">
                    <TextBlock Text="OPERACIÓN" FontSize="11" FontWeight="Bold" Opacity="0.5" Margin="0,0,0,12"/>
                    <UniformGrid Columns="2">
                        <!-- Tarjeta Contratos -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="24" MinHeight="140" Margin="0,0,10,0" Cursor="Hand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                                    <Border Width="38" Height="38" Background="#1A0EA5E9" CornerRadius="8" Margin="0,0,12,0">
                                        <ui:SymbolIcon Symbol="DocumentTable24" FontSize="20" Foreground="#0EA5E9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Contratos" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="Contratos por periodo, estatus y cliente." FontSize="13" Opacity="0.6" Margin="0,0,0,15" TextWrapping="Wrap"/>

                                <Grid Grid.Row="2">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Generar reporte" FontSize="13" FontWeight="Medium" Foreground="#0EA5E9" Margin="0,0,6,0"/>
                                        <ui:SymbolIcon Symbol="ChevronRight16" FontSize="12" Foreground="#0EA5E9" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <!-- Espacio vacío simétrico para mantener la cuadrícula -->
                        <Rectangle/>
                    </UniformGrid>
                </StackPanel>

                <!-- 6. Sección: INVENTARIO -->
                <StackPanel Grid.Row="5" Margin="0,0,0,10">
                    <TextBlock Text="INVENTARIO" FontSize="11" FontWeight="Bold" Opacity="0.5" Margin="0,0,0,12"/>
                    <UniformGrid Columns="3">
                        <!-- Tarjeta Urnas -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="24" MinHeight="140" Margin="0,0,7,0" Cursor="Hand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                                    <Border Width="38" Height="38" Background="#1A0EA5E9" CornerRadius="8" Margin="0,0,12,0">
                                        <ui:SymbolIcon Symbol="Box24" FontSize="20" Foreground="#0EA5E9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Urnas" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="Existencias, ventas y modelos más solicitados." FontSize="13" Opacity="0.6" Margin="0,0,0,15" TextWrapping="Wrap"/>

                                <Grid Grid.Row="2">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Generar reporte" FontSize="13" FontWeight="Medium" Foreground="#0EA5E9" Margin="0,0,6,0"/>
                                        <ui:SymbolIcon Symbol="ChevronRight16" FontSize="12" Foreground="#0EA5E9" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Tarjeta Servicios -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="24" MinHeight="140" Margin="4,0,4,0" Cursor="Hand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                                    <Border Width="38" Height="38" Background="#1A0EA5E9" CornerRadius="8" Margin="0,0,12,0">
                                        <ui:SymbolIcon Symbol="Briefcase24" FontSize="20" Foreground="#0EA5E9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Servicios" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="Servicios contratados y su ingreso." FontSize="13" Opacity="0.6" Margin="0,0,0,15" TextWrapping="Wrap"/>

                                <Grid Grid.Row="2">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Generar reporte" FontSize="13" FontWeight="Medium" Foreground="#0EA5E9" Margin="0,0,6,0"/>
                                        <ui:SymbolIcon Symbol="ChevronRight16" FontSize="12" Foreground="#0EA5E9" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Tarjeta Paquetes -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="24" MinHeight="140" Margin="7,0,0,0" Cursor="Hand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                                    <Border Width="38" Height="38" Background="#1A0EA5E9" CornerRadius="8" Margin="0,0,12,0">
                                        <ui:SymbolIcon Symbol="Box24" FontSize="20" Foreground="#0EA5E9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Paquetes" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="Paquetes vendidos y su composición." FontSize="13" Opacity="0.6" Margin="0,0,0,15" TextWrapping="Wrap"/>

                                <Grid Grid.Row="2">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Generar reporte" FontSize="13" FontWeight="Medium" Foreground="#0EA5E9" Margin="0,0,6,0"/>
                                        <ui:SymbolIcon Symbol="ChevronRight16" FontSize="12" Foreground="#0EA5E9" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </ui:ListViewItem>
    </ui:ListView>
</Page>