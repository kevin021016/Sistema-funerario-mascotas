<Page x:Class="Sistema_funerario_mascotas.Views.Users.CrearUsuarioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008" 
      xmlns:local="clr-namespace:Sistema_funerario_mascotas"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CrearUsuarioPage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Migas de pan (Breadcrumb) -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Home" Opacity="0.5" FontSize="12"/>
            <TextBlock Text=" > " Opacity="0.5" FontSize="12" Margin="5,0"/>
            <TextBlock Text="Dashboard" Opacity="0.5" FontSize="12"/>
            <TextBlock Text=" > " Opacity="0.5" FontSize="12" Margin="5,0"/>
            <TextBlock Text="Lista de usuarios" FontSize="12" FontWeight="SemiBold"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Lista de usuarios" FontSize="26" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- TARJETA CONTENEDORA DEL FORMULARIO -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="25" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. CONTENEDOR PRINCIPAL DE LAS 2 MITADES (Izquierda y Derecha) -->
                <Grid Grid.Row="0" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- COLUMNA IZQUIERDA -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Nombre" Margin="0,0,0,6" FontWeight="Medium"/>
                        <ui:TextBox Grid.Row="1" PlaceholderText="Ingrese el nombre..." Margin="0,0,0,15" HorizontalAlignment="Stretch"/>

                        <TextBlock Grid.Row="2" Text="Correo Electrónico" Margin="0,0,0,6" FontWeight="Medium"/>
                        <ui:TextBox Grid.Row="3" PlaceholderText="ejemplo@correo.com" Margin="0,0,0,0" HorizontalAlignment="Stretch"/>
                    </Grid>

                    <!-- COLUMNA DERECHA -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Apellidos" Margin="0,0,0,6" FontWeight="Medium"/>
                        <ui:TextBox Grid.Row="1" PlaceholderText="Ingrese los apellidos..." Margin="0,0,0,15" HorizontalAlignment="Stretch"/>

                        <TextBlock Grid.Row="2" Text="Teléfono" Margin="0,0,0,6" FontWeight="Medium"/>
                        <ui:TextBox x:Name="TxtTelefono" Grid.Row="3" PlaceholderText="Ej. 6120000000" Margin="0,0,0,0" HorizontalAlignment="Stretch"
                                    PreviewTextInput="Numero_PreviewTextInput" 
                                    DataObject.Pasting="Texto_Pasting"/>
                    </Grid>
                </Grid>

                <!-- 2. CAMPO EXTRA INFERIOR (Rol a lo ancho) -->
                <StackPanel Grid.Row="1" Margin="0,15,0,0">
                    <TextBlock Text="Rol de Usuario" Margin="0,0,0,6" FontWeight="Medium"/>
                    <ComboBox SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem IsEnabled="False" Content="-- Seleccione un Rol --"/>
                        <ComboBoxItem Content="Administrador"/>
                        <ComboBoxItem Content="Vendedor"/>
                        <ComboBoxItem Content="Asesor"/>
                    </ComboBox>
                </StackPanel>

                <!-- 3. CONTRASEÑA Y CONFIRMAR (En dos mitades simétricas) -->
                <Grid Grid.Row="2" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Columna Izquierda: Contraseña -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Contraseña" Margin="0,0,0,6" FontWeight="Medium"/>
                        <ui:PasswordBox PlaceholderText="••••••••" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Columna Derecha: Confirmar Contraseña -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Confirmar Contraseña" Margin="0,0,0,6" FontWeight="Medium"/>
                        <ui:PasswordBox PlaceholderText="••••••••" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 4. BOTONES DE ACCIÓN ABAJO A LA DERECHA (Fuera de la tarjeta) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <ui:Button Content="Cancelar" Appearance="Secondary" Width="120" Margin="0,0,10,0"/>
            <ui:Button Content="Guardar Usuario" Appearance="Primary" Width="150"/>
        </StackPanel>
    </Grid>
</Page>