<Page x:Class="Sistema_funerario_mascotas.UsuariosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008" 
      xmlns:local="clr-namespace:Sistema_funerario_mascotas"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      Title="UsuariosPage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Migas de pan (Breadcrumb) -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Dashboard" Opacity="0.5" Cursor="Hand" MouseLeftButtonUp="BreadcrumbDashboard_Click" FontSize="12"/>
            <TextBlock Text=" > " Opacity="0.5" FontSize="12" Margin="5,0"/>
            <TextBlock Text="Lista de usuarios" FontSize="12" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Título -->
        <TextBlock Grid.Row="1" Text="Lista de usuarios" FontSize="26" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Barra de Acciones (Buscador + Botón Agregar) -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Buscador -->
            <ui:TextBox Grid.Column="0" x:Name="TxtBuscador" PlaceholderText="Buscar por nombre, correo..." Icon="{ui:SymbolIcon Search24}" TextChanged="TxtBuscador_TextChanged"/>

            <!-- Botón Agregar Usuario -->
            <ui:Button Grid.Column="2" Content="+ Agregar usuario" Foreground="White" FontWeight="Medium" Cursor="Hand" Appearance="Primary" Click="IrAgregarUsuario_Click"/>
        </Grid>

        <!-- Contenedor de la Tabla -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabecera de la Tabla -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="NOMBRE" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                    <TextBlock Grid.Column="1" Text="APELLIDOS" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                    <TextBlock Grid.Column="2" Text="EMAIL" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                    <TextBlock Grid.Column="3" Text="ÚLTIMA VEZ ACTIVO" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                    <TextBlock Grid.Column="4" Text="ACCIONES" FontWeight="Bold" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
                </Grid>

                <!-- Separador sutil -->
                <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,10"/>

                <!-- LISTA DINÁMICA DE USUARIOS CON WPF UI LISTVIEW -->
                <ui:ListView Grid.Row="2" x:Name="IcUsuarios"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ui:ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ui:ListViewItem}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <!-- Efecto Hover -->
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ui:ListView.ItemContainerStyle>

                    <ui:ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid Margin="0,10,0,10" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Nombre y Rol -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding rol}" Foreground="#3B82F6" FontSize="12"/>
                                    </StackPanel>

                                    <!-- Apellidos -->
                                    <TextBlock Grid.Column="1" Text="{Binding apellidos}" VerticalAlignment="Center" Opacity="0.9"/>

                                    <!-- Email -->
                                    <TextBlock Grid.Column="2" Text="{Binding email}" VerticalAlignment="Center" Opacity="0.9"/>

                                    <!-- Última vez activo -->
                                    <TextBlock Grid.Column="3" Text="{Binding last_active_at, TargetNullValue='N/A'}" VerticalAlignment="Center" Opacity="0.7"/>

                                    <!-- Botones de Acción -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Width="32" Height="32" Margin="3" Padding="0" Background="#0EA5E9" BorderBrush="{x:Null}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="Ver" Click="IrDetallesUsuario_Click">
                                            <ui:SymbolIcon Symbol="Eye24" FontSize="14"/>
                                        </Button>
                                        <Button Width="32" Height="32" Margin="3" Padding="0" Background="#EAB308" BorderBrush="{x:Null}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="Editar" Click="IrEditarUsuario_Click">
                                            <ui:SymbolIcon Symbol="Edit24" FontSize="14"/>
                                        </Button>
                                        <Button Width="32" Height="32" Margin="3" Padding="0" Background="#EF4444" BorderBrush="{x:Null}" 
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="Eliminar" Click="BtnEliminar_Click" CommandParameter="{Binding id}">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,5"/>
                            </StackPanel>
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>

                <!-- Controles de Paginación -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <ui:Button x:Name="BtnAnterior" Content="Anterior" Appearance="Secondary" Width="90" Margin="0,0,10,0" Click="BtnAnterior_Click"/>
                    <TextBlock x:Name="TxtPaginaActual" Text="Página 1 de 1" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.8"/>
                    <ui:Button x:Name="BtnSiguiente" Content="Siguiente" Appearance="Secondary" Width="90" Click="BtnSiguiente_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Botones de Exportar al final -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <ui:Button Content="Imprimir lista (PDF)" Margin="5,0,5,0" Click="ExportPdf_Click" Appearance="Secondary"/>
            <ui:Button Content="Exportar a Excel" Margin="5,0,0,0" Click="ExportExcel_Click" Appearance="Secondary"/>
        </StackPanel>

        <ui:SnackbarPresenter x:Name="SnackbarHost" Grid.Row="0" Grid.RowSpan="5"/>


    </Grid>
</Page>