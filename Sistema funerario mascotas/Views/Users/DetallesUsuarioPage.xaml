<Page x:Class="Sistema_funerario_mascotas.Views.Users.DetallesUsuarioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Sistema_funerario_mascotas"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="800"
      Title="DetallesUsuarioPage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Migas de pan (Breadcrumb) -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Dashboard" Opacity="0.5" FontSize="12" Cursor="Hand" MouseLeftButtonUp="BreadcrumbDashboard_Click"/>
            <TextBlock Text=" > " Opacity="0.5" FontSize="12" Margin="5,0"/>
            <TextBlock Text="Lista de usuarios" Opacity="0.5" FontSize="12" Cursor="Hand" MouseLeftButtonUp="BreadcrumbUsuarios_Click"/>
            <TextBlock Text=" > " Opacity="0.5" FontSize="12" Margin="5,0"/>
            <TextBlock Text="Editar usuario" FontSize="12" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Título -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Botón Volver con flechita -->
            <ui:Button Grid.Column="0" Width="38" Height="38" Padding="0" Margin="0,0,15,0" 
               Appearance="Secondary" ToolTip="Volver a la lista" 
               HorizontalAlignment="Left" VerticalAlignment="Center" 
               Click="BtnVolver_Click">
                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16"/>
            </ui:Button>

            <!-- Título de la página -->
            <TextBlock Grid.Column="1" Text="Detalles de usuario" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
        </Grid>

        <!-- TARJETA 1: INFORMACIÓN BÁSICA DEL USUARIO -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="25" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- COLUMNA IZQUIERDA -->
                    <StackPanel Grid.Column="0">
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Nombre" Margin="0,0,0,6" FontWeight="Medium" Opacity="0.6"/>
                            <ui:TextBox x:Name="TxtNombre" IsReadOnly="True" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Correo Electrónico" Margin="0,0,0,6" FontWeight="Medium" Opacity="0.6"/>
                            <ui:TextBox x:Name="TxtEmail" IsReadOnly="True" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- COLUMNA DERECHA -->
                    <StackPanel Grid.Column="2">
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Apellidos" Margin="0,0,0,6" FontWeight="Medium" Opacity="0.6"/>
                            <ui:TextBox x:Name="TxtApellidos" IsReadOnly="True" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Teléfono" Margin="0,0,0,6" FontWeight="Medium" Opacity="0.6"/>
                            <ui:TextBox x:Name="TxtTelefono" IsReadOnly="True" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Rol de Usuario -->
                <StackPanel Grid.Row="1" Margin="0,15,0,0">
                    <TextBlock Text="Rol de Usuario" Margin="0,0,0,6" FontWeight="Medium" Opacity="0.6"/>
                    <ui:TextBox x:Name="TxtRol" IsReadOnly="True" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TARJETA 2: TABLA DE MOVIMIENTOS / HISTORIAL DE ACTIVIDAD -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título de la tarjeta -->
                <TextBlock Grid.Row="0" Text="Historial de Movimientos" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <!-- Mensaje condicional si no es Administrador -->
                <TextBlock Grid.Row="2" x:Name="TxtNoAdministrador" Text="El usuario no tiene movimientos ya que no es Administrador" 
                           FontStyle="Italic" Opacity="0.6" Margin="0,10,0,10" Visibility="Collapsed"/>

                <!-- Contenedor interno de la tabla para administradores -->
                <Grid Grid.Row="2" x:Name="PnlLogsContainer">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Cabecera de la Tabla -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ACCIÓN" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                        <TextBlock Grid.Column="1" Text="MÓDULO" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                        <TextBlock Grid.Column="2" Text="DESCRIPCIÓN" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                        <TextBlock Grid.Column="3" Text="FECHA" FontWeight="Bold" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
                    </Grid>

                    <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,10"/>

                    <!-- LISTA DINÁMICA DE MOVIMIENTOS CON ui:ListView (Igual que UsuariosPage) -->
                    <ui:ListView Grid.Row="2" x:Name="IcLogs"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ui:ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ui:ListViewItem}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <!-- Efecto Hover integrado -->
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1AFFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ui:ListView.ItemContainerStyle>

                        <ui:ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid Margin="0,8,0,8" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Acción -->
                                        <TextBlock Grid.Column="0" Text="{Binding action}" FontWeight="SemiBold" Foreground="#3B82F6"/>
                                        <!-- Módulo / Subject -->
                                        <TextBlock Grid.Column="1" Text="{Binding subject}" Opacity="0.9"/>
                                        <!-- Descripción -->
                                        <TextBlock Grid.Column="2" Text="{Binding description}" Opacity="0.9" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                        <!-- Fecha -->
                                        <TextBlock Grid.Column="3" Text="{Binding FechaLegible}" Opacity="0.7" HorizontalAlignment="Center" FontSize="12"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,2" Opacity="0.5"/>
                                </StackPanel>
                            </DataTemplate>
                        </ui:ListView.ItemTemplate>
                    </ui:ListView>
                </Grid>

                <!-- Controles de Paginación (Fila 3 de la tarjeta) -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <ui:Button x:Name="BtnAnterior" Content="Anterior" Appearance="Secondary" Width="90" Margin="0,0,10,0" Click="BtnAnterior_Click"/>
                    <TextBlock x:Name="TxtPaginaActual" Text="Página 1 de 1" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.8"/>
                    <ui:Button x:Name="BtnSiguiente" Content="Siguiente" Appearance="Secondary" Width="90" Click="BtnSiguiente_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. BOTÓN DE REGRESAR ABAJO A LA DERECHA -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <ui:Button Content="Volver" Appearance="Secondary" Width="120" Click="BtnVolver_Click"/>
        </StackPanel>
    </Grid>
</Page>